{
  "name": "deadlock-optimal-build-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "ui-lint": "node scripts/ui-lint.mjs",
    "fetch-data": "node scripts/fetch-data.mjs",
    "generate": "npx tsx scripts/generate-cli.ts",
    "verify": "npx tsx scripts/verify.ts",
    "verify:browser": "npm run build && node scripts/browser-check.mjs",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css}": [
      "prettier --write",
      "oxlint"
    ],
    "src/**/*.{ts,tsx}": [
      "node scripts/ui-lint.mjs"
    ]
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lucide-react": "^1.47.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
